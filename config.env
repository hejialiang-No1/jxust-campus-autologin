# campus-autologin 配置 — 江西理工大学 JXUST-WLAN 预设
# 改完直接生效，无需重启守护。命令说明: campus-autologin -h

# ---------- 账号 ----------
# 用 `campus-autologin set-cred` 填学号 + 一卡通密码；密码只存 macOS 钥匙串
USERNAME=""

# 运营商后缀（拼在学号后面）：电信 @telecom / 移动 @cmcc / 联通 @unicom / 无后缀留空
# 由网关注销页确认：移动用 @cmcc
# 登录报「账号或密码错误」时，先换这个后缀试试
ACCOUNT_SUFFIX="@cmcc"

# ---------- 触发范围 ----------
# 只在 JXUST-WLAN 下认证；大小写不敏感、模糊匹配
SSID_MATCH="jxust-wlan"

# ---------- 认证接口：锐捷 ePortal，GET 请求 ----------
# 来源：JXUST 校园网登录页 F12 抓到的 portal/login 请求
# http://10.17.8.18:801/eportal/portal/login?callback=dr1003&login_method=1&user_account=学号%40cmcc&user_password=密码
# login_method 是「认证协议/认证方式」（ePortal 前端 JS 里标注为认证协议），不是运营商；
# 运营商由 user_account 的后缀决定，所以电信/移动/联通都用 1。
# 教程实测：只保留到 user_password 即可登录，多余字段省略避免 wlan_user_mac 全零被误校验。
LOGIN_URL="http://10.17.8.18:801/eportal/portal/login"
LOGIN_METHOD="GET"
POST_FIELDS="callback=dr1003&login_method=1&user_account={{USER}}&user_password={{PASS}}"

# ---------- 在线判定 ----------
# 10.17.8.18 (Dr.COM 网关) 首页：
#   已认证 → <title>注销页</title> + Dr.COMWebLoginID_1.htm
#   未认证 → <title>上网登录页</title> + Dr.COMWebLoginID_0.htm
# 实测坑：登录页里有 `authsuccess='Dr.COMWebLoginID_3.htm'`，判据里若含 Success
#         （grep -i）会误命中 authsuccess，导致未认证被当成已联网、永不触发认证。
#         所以只用上面两个互斥标记，并把登录页标记放进 OFFLINE_REGEX 优先排除。
# captive.apple.com 在本校走 CDN 缓存，未认证也可能返回 Success，绝不用它降级判定。
CHECK_URL="http://10.17.8.18/"
ONLINE_REGEX="<title>注销页</title>|Dr\.COMWebLoginID_1\.htm"
OFFLINE_REGEX="<title>上网登录页</title>|Dr\.COMWebLoginID_0\.htm"
SUCCESS_REGEX="success|已认证|认证成功|登录成功|result.:1"

# 多网卡说明：本机同时接了 iPhone USB 热点(en10)，默认路由走 172.20.10.1，
# 不绑定接口时 10.17.8.18 的 Portal 完全不可达、认证会静默超时。
# 脚本已自动把所有探测/认证请求绑定到 Wi-Fi 设备（有 IP 时），无需额外配置。

# 固定接口不依赖会话 Cookie，关掉预取更快
PREGET=0

# 这些字段运行时用「本次 Portal 跳转 URL 里的同名参数」自动覆盖
DYNAMIC_FIELDS="wlan_user_ip,wlanuserip,wlan_ac_ip,wlan_ac_name,queryString,userip,nasip,ac_id"

# 防抖秒数；连续失败按 2 倍退避，上限 MAX_BACKOFF 秒
DEBOUNCE_SEC=25
MAX_BACKOFF=300

# ---------- 触发速度 / 登录页弹窗 ----------
# 兜底检测周期（秒）。改小 → 掉线后恢复更快；改完跑一次 install 才会写进 plist
CHECK_INTERVAL=30
# 极速通道：Wi-Fi 刚连上、DHCP 还没发完 IP 时，脚本会在本轮内短轮询等网关，
# 一通就立刻认证并跳过防抖，抢在 macOS 弹出「网络登录页」之前完成。
# FAST_WAIT_SEC=0 可关闭这个行为（否则弹窗窗口会变长）。
FAST_WAIT_SEC=15
FAST_POLL_SEC=2
# macOS 27 的 captiveagent 已无法用 com.apple.captive.control Active=false 禁用
# （用户级+系统级都写了照样弹，新版读的是 CaptiveNetworkSupport 域）。
# 弹窗只发生在「连 Wi-Fi → 自动认证完成」那一两秒，认证成功后守护会自动收起窗口。
# 想立刻手动收：campus-autologin close-popup
# 浏览器里被 AC 302 出来的登录页标签页：先手动跑一次 close-popup 完成自动化授权，
# 再把下面改成 1，之后认证成功时会自动关掉这些标签页（没授权前开 1 会弹授权框）。
CLOSE_BROWSER_TABS=0

# ---------- 日志 ----------
# 超过该行数自动 gzip 归档，只保留最近 3 份，避免长期运行堆到几十万行
LOG_MAX_LINES=3000

# ---------- 占位符（可写在 LOGIN_URL / POST_FIELDS 里）----------
#   {{USER}} {{PASS}}          账号(含运营商后缀) / 密码
#   {{IP}} {{MAC}} {{SSID}}    本机 IP / MAC / 当前 Wi-Fi 名
#   {{TS}}                     秒级时间戳
#   {{PORTAL_URL}}             本次抓到的 Portal 跳转完整 URL
#   {{QUERY_ALL}}              跳转 URL 的整段 query（curl 会自动 URL 编码）
#   {{QUERY:参数名}}            跳转 URL 里某个参数的值
# 字段用 & 分隔，curl 会逐字段 URL 编码，密码里的特殊字符不会出错。

# ---------- 若学校换了认证系统 ----------
# 连上校园网但先别登录 → campus-autologin probe 抓跳转和表单（报告: ~/.config/campus-autologin/probe.txt）
# 或浏览器 F12 → 网络 → 手动登录一次 → 复制为 cURL → campus-autologin import-curl
# 其他常见接口（按需取消注释）:
# [锐捷 ePortal POST 版] LOGIN_METHOD="POST"
# LOGIN_URL="http://10.0.0.1/eportal/InterFace.do?method=login"
# POST_FIELDS="userId={{USER}}&password={{PASS}}&service=&queryString={{QUERY_ALL}}&operatorPwd=&operatorUserId=&validcode=&passwordEncrypt=false"
# [深澜 Srun] LOGIN_METHOD="POST"
# LOGIN_URL="http://10.0.0.1/cgi-bin/srun_portal"
# POST_FIELDS="action=login&username={{USER}}&password={{PASS}}&ac_id=1&user_ip={{IP}}&nas_ip=&user_mac={{MAC}}&url=&save_me=1"
